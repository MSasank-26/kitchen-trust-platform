{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2021",

    "moduleResolution": "Node16",

    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",

    "incremental": true,

    "strict": false,
    "skipLibCheck": true
  },

  "include": ["src/**/*"],

  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}